#!/usr/bin/env zsh
set -e

repo_dir="${0:A:h:h}"
source "${repo_dir}/ii.plugin.zsh"

for topic in ${(f)"$(ii_help_topics)"}; do
  print "===== ii ${topic} ====="
  if [[ "$topic" == "help" ]]; then
    output="$(ii help)"
  else
    output="$(ii help "$topic")"
  fi
  if [[ "$output" != *$'usage:'* || "$output" != *$'Aliases:'* || "$output" != *$'Help:'* ]]; then
    print -u2 "missing usage, Aliases, or Help section: $topic"
    exit 1
  fi
  print -r -- "$output"
  print
done

# Verify every direct dispatcher spelling reaches self-contained help without
# entering normal command execution. Fixed-option paths are audited separately
# because they are routes rather than standalone dispatcher commands.
audit_commands=(
  set s sr sf sha get g gr gl clip clipboard load l la sync interactive i
  ls list variable vars var v vo voc payload p pc pe pce pic pie pice tmux
  unset u version -v --version help h -h --help
)
for command in "$audit_commands[@]"; do
  for help_flag in --help -h; do
    output="$(ii "$command" "$help_flag")"
    if [[ "$output" != *$'usage:'* || "$output" != *$'Aliases:'* || "$output" != *$'Help:'* ]]; then
      print -u2 "direct dispatcher help failed: $command $help_flag"
      exit 1
    fi
  done
done

audit_routes=(
  "load --all-pane" "l --all-pane"
  "sync on" "sync off" "sync status"
  "clip backend" "clip doctor"
  "p --copy" "p --execute" "p --copy --execute"
  "p --input" "p --input --copy" "p --input --execute"
  "p --input --copy --execute" "p --www" "p --www --file"
  "p --www ln" "p --www ls" "p --www search" "v --out"
  "tmux status" "unset -a"
)
for route in "$audit_routes[@]"; do
  for help_flag in --help -h; do
    output="$(ii ${(z)route} "$help_flag")"
    if [[ "$output" != *$'usage:'* || "$output" != *$'Aliases:'* || "$output" != *$'Help:'* ]]; then
      print -u2 "fixed route help failed: $route $help_flag"
      exit 1
    fi
  done
done

audit_help_routes=(
  "load --all-pane" "l --all-pane"
  "sync on" "sync off" "sync status"
  "clip backend" "clip doctor"
  "v --out" "p --copy" "p --execute" "p --copy --execute"
  "p --input" "p --input --copy" "p --input --execute"
  "p --input --copy --execute" "p --www" "p --www --file"
  "p --www ln" "p --www ls" "p --www search"
  "tmux status" "unset -a"
)
for route in "$audit_help_routes[@]"; do
  output="$(ii help ${(z)route})"
  if [[ "$output" != *$'usage:'* || "$output" != *$'Aliases:'* || "$output" != *$'Help:'* ]]; then
    print -u2 "help route failed: ii help $route"
    exit 1
  fi
done

ii_help_require_fragments() {
  local label="$1" help_output="$2" fragment
  shift 2
  for fragment in "$@"; do
    if [[ "$help_output" != *"$fragment"* ]]; then
      print -u2 "missing child usage in $label: $fragment"
      return 1
    fi
  done
}

# Parent help must enumerate every direct child path and its fixed aliases.
output="$(ii --help)"
ii_help_require_fragments "ii --help" "$output" \
  "set|s NAME=VALUE" "sr VALUE" "get|g FILTER" "gr" "gl" "clip|clipboard backend" \
  "set|s --from-file [PATH] | sf [PATH]" "set|s --from-shell -a | sha" \
  "load|l" "load --all-pane|la" "sync [on|off|status]" "interactive|i" \
  "ls|list|variable|vars|var [PATTERN]" "v --out [PATH]" "vo [PATH]" \
  "voc [PATH]" "unset|u NAME" "payload|p --copy" "pc [KEYWORD" \
  "payload|p --execute" "pe [KEYWORD" "payload|p --copy --execute" \
  "pce [KEYWORD" "payload|p --input --copy" "pic [-o [PATH]]" \
  "payload|p --input --execute" "pie" "payload|p --input --copy --execute" \
  "pice" "payload|p --www" "tmux status" \
  "version|-v|--version" "help|h|-h|--help"

output="$(ii p --help)"
ii_help_require_fragments "ii p --help" "$output" \
  "ii p --copy [KEYWORD" "ii pc [KEYWORD" "ii p --execute [KEYWORD" \
  "ii pe [KEYWORD" "ii p --copy --execute [KEYWORD" "ii pce [KEYWORD" \
  "ii p --input [-o [PATH]]" "ii p --input --copy [-o [PATH]]" \
  "ii pic [-o [PATH]]" "ii p --input --execute [-o [PATH]]" \
  "ii pie" \
  "ii p --input --copy --execute [-o [PATH]]" "ii pice" \
  "ii p --www --file PATH" "ii p --www ln" "ii p --www ls" \
  "ii p --www search"

output="$(ii p --input --help)"
ii_help_require_fragments "ii p --input --help" "$output" \
  "ii p --input [-o [PATH]]" "ii p --input --copy [-o [PATH]]" \
  "ii pic [-o [PATH]]" "ii p --input --execute [-o [PATH]]" \
  "ii pie" \
  "ii p --input --copy --execute [-o [PATH]]" "ii pice"

output="$(ii p --www --help)"
ii_help_require_fragments "ii p --www --help" "$output" \
  "ii p --www --file PATH" "ii p --www ln SOURCE_PATH" \
  "ii p --www ls" "ii p --www search [FILTER]"

output="$(ii v --help)"
ii_help_require_fragments "ii v --help" "$output" \
  "ii v [PATTERN]" "ii v --out [PATH]" "ii vo [PATH]" "ii voc [PATH]"

output="$(ii tmux --help)"
ii_help_require_fragments "ii tmux --help" "$output" \
  "ii tmux status" "II_TMUX_INTEGRATION=0" "II_TMUX_INTEGRATION_FORCE=1"

output="$(ii load --help)"
ii_help_require_fragments "ii load --help" "$output" \
  "ii load --all-pane" "ii la" "likely ready" \
  '"dispatched" means the command'

output="$(ii help get)"
ii_help_require_fragments "ii help get" "$output" \
  "ii help get" "ii help g"

output="$(ii help set)"
ii_help_require_fragments "ii help set" "$output" \
  "ii set --from-file [PATH]" "ii s --from-file [PATH]" \
  "ii sf [PATH]" "ii sha" "defaulting to .env"

output="$(ii help unset)"
ii_help_require_fragments "ii help unset" "$output" \
  "ii help unset" "ii help u"

colored="$(II_COLOR=always NO_COLOR= ii help load)"
[[ "$colored" == *$'  \033[36ml\033[0m\n'* ]] || {
  print -u2 "help alias color missing: l"
  exit 1
}
[[ "$colored" == *$'  \033[36mla\033[0m    ii load --all-pane'* ]] || {
  print -u2 "help alias annotation color boundary failed: la"
  exit 1
}
[[ "$colored" != *$'\033[36mii load --all-pane'* ]] || {
  print -u2 "help alias annotation was colored"
  exit 1
}

plain="$(II_COLOR=always NO_COLOR=1 ii help load)"
[[ "$plain" != *$'\033['* ]] || {
  print -u2 "NO_COLOR did not suppress help alias color"
  exit 1
}

unset audit_commands audit_routes audit_help_routes command help_flag output route topic
unfunction ii_help_require_fragments
