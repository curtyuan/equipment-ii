#!/usr/bin/env zsh

set -eu
setopt pipefail

root="${0:A:h:h}"
tmp="$(mktemp -d)"
socket="${tmp}/tmux.sock"

cleanup() {
  zpty -d ii-popup-client 2>/dev/null || true
  tmux -S "$socket" kill-server 2>/dev/null || true
  rm -rf -- "$tmp"
}
trap cleanup EXIT

fail() {
  print -u2 -r -- "tmux popup input test failed: $*"
  exit 1
}

zmodload zsh/zpty || fail zpty-unavailable
tmux -f /dev/null -S "$socket" new-session -d -s popup-input-test -x 100 -y 30 'zsh -f'
server_pid="$(tmux -S "$socket" display-message -p -t popup-input-test:0.0 '#{pid}')"
pane="$(tmux -S "$socket" display-message -p -t popup-input-test:0.0 '#{pane_id}')"
tmux_env="${socket},${server_pid},0"

env TMUX="$tmux_env" TMUX_PANE="$pane" II_CONFIG_FILE=/dev/null \
  zsh -fc "source ${(q)root}/ii.plugin.zsh"
tmux -S "$socket" set-environment -g II_INTERACTIVE_KEY y

TERM=xterm-256color zpty ii-popup-client \
  tmux -S "$socket" attach-session -t popup-input-test
sleep 0.5
tmux -S "$socket" command-prompt &
prompt_pid=$!
sleep 0.1
zpty -w ii-popup-client 'ii'$'\r'
sleep 0.3
zpty -w ii-popup-client 'echo POPUP_INPUT_OK'$'\r'
output=""
for attempt in {1..30}; do
  while zpty -r -t ii-popup-client chunk 2>/dev/null; do
    output+="$chunk"
  done
  [[ "$output" == *'Send and execute?'* ]] && break
  sleep 0.1
done
if [[ "$output" != *'Send and execute?'* ]]; then
  print -u2 -r -- "$output"
  fail pie-confirmation-not-reached
fi
[[ "$output" == *'ii input>'* ]] || fail input-prompt-not-shown
[[ "$output" == *'echo POPUP_INPUT_OK'* ]] || fail typed-input-not-received
[[ "$output" == *'Send and execute? [y/N]'* ]] || fail pie-confirmation-not-shown
[[ "$output" != *'Copy, send and execute?'* ]] || fail copy-mode-used

pane_output=""
for attempt in {1..30}; do
  pane_output="$(tmux -S "$socket" capture-pane -p -t "$pane")"
  [[ "$pane_output" == *'POPUP_INPUT_OK'* ]] && break
  sleep 0.1
done
if [[ "$pane_output" != *'POPUP_INPUT_OK'* ]]; then
  while zpty -r -t ii-popup-client chunk 2>/dev/null; do
    output+="$chunk"
  done
  print -u2 -r -- "$output"
  print -u2 -r -- "$pane_output"
  fail payload-not-executed-in-origin-pane
fi

zpty -d ii-popup-client
wait "$prompt_pid" 2>/dev/null || true

print "tmux native alias popup input test passed"
