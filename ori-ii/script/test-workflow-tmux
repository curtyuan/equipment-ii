#!/usr/bin/env zsh

set -eu
setopt pipefail

root="${0:A:h:h}"
tmp="$(mktemp -d)"
socket="${tmp}/tmux.sock"

cleanup() {
  tmux -S "$socket" kill-server 2>/dev/null || true
  rm -rf -- "$tmp"
}
trap cleanup EXIT

fail() {
  print -u2 -r -- "workflow tmux test failed: $*"
  exit 1
}

tmux -S "$socket" new-session -d -s workflow-test -x 100 -y 30 'zsh -f'
tmux -S "$socket" split-window -d -t workflow-test:0 'zsh -f'
sleep 1

server_pid="$(tmux -S "$socket" display-message -p -t workflow-test:0.0 '#{pid}')"
export TMUX="${socket},${server_pid},0"
export TMUX_PANE="$(tmux -S "$socket" display-message -p -t workflow-test:0.0 '#{pane_id}')"
II_TMUX_INTEGRATION=0 source "${root}/ii.plugin.zsh"

session="$(tmux display-message -p -t workflow-test:0.0 '#{session_id}')"
origin="$TMUX_PANE"
target="$(tmux display-message -p -t workflow-test:0.1 '#{pane_id}')"

ii_tmux_send_literal "$session" "$target" 'print -r -- WORKFLOW_TRANSPORT_OK'
sleep 1
tmux capture-pane -p -t "$target" -S -20 | grep -Fq WORKFLOW_TRANSPORT_OK || fail transport

II_WORKFLOW_LANES=(kali-main remote-main)
typeset -gA II_WORKFLOW_LANE_ROLE=(kali-main kali remote-main remote)
typeset -gA II_WORKFLOW_LANE_ORDINAL=(kali-main 1 remote-main 2)
ii_workflow_discover_panes "$session" || fail discovery
[[ "${#II_WORKFLOW_PANES}" == 2 ]] || fail pane-count
ii_workflow_detect_initial_assignments "$session" "$origin"
ii_workflow_assignments_complete || fail initial-assignment
[[ "${II_WORKFLOW_LANE_PANE[kali-main]}" == "$origin" ]] || fail kali-origin

ii_workflow_memory_write "$session"
ii_workflow_memory_read "$session"
[[ "${II_WORKFLOW_REMEMBERED_PANE[kali-main]}" == "$origin" ]] || fail memory

tmux set-option -t "$session" "$II_WORKFLOW_MEMORY_OPTION" \
  $'kali-stale=%999999\nremote-main='"$origin"$'\nkali-conflict='"$origin"
ii_workflow_memory_read "$session"
[[ -z "${II_WORKFLOW_REMEMBERED_PANE[kali-stale]-}" ]] || fail stale-memory
[[ "${II_WORKFLOW_REMEMBERED_PANE[remote-main]-}" == "$origin" ]] || fail valid-memory
[[ -z "${II_WORKFLOW_REMEMBERED_PANE[kali-conflict]-}" ]] || fail conflicting-memory

ii_tmux_send_literal "$session" "$origin" 'print -r -- WORKFLOW_ORDER_1'
ii_tmux_send_literal "$session" "$target" 'print -r -- WORKFLOW_ORDER_2'
ii_tmux_send_literal "$session" "$origin" 'print -r -- WORKFLOW_ORDER_3'
sleep 1
origin_capture="$(tmux capture-pane -p -t "$origin" -S -30)"
target_capture="$(tmux capture-pane -p -t "$target" -S -30)"
[[ "$origin_capture" == *WORKFLOW_ORDER_1*WORKFLOW_ORDER_3* ]] || fail repeated-lane-order
[[ "$target_capture" == *WORKFLOW_ORDER_2* ]] || fail alternating-lane-target
[[ "$target_capture" != *WORKFLOW_ORDER_1* && "$target_capture" != *WORKFLOW_ORDER_3* ]] || fail lane-isolation

tmux select-layout -t workflow-test:0 even-horizontal
tmux select-pane -t "$target" -T changed-title
ii_tmux_pane_identity_valid "$target" "$session" || fail harmless-layout-title-change
tmux new-window -d -t workflow-test -n moved 'zsh -f'
tmux move-pane -s "$target" -t workflow-test:moved
ii_tmux_pane_identity_valid "$target" "$session" || fail harmless-window-change
tmux kill-pane -t "$target"
ii_tmux_pane_identity_valid "$target" "$session" >/dev/null 2>&1 && fail disappeared-pane

print "workflow tmux tests passed"
