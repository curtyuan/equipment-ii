# description: 本機 nc 雙 pane 傳輸測試，產生隨機資料並以 cmp 驗證接收內容
# flow: 1
# note: 先確認 listener pane 已顯示 listening，再執行 connector stage。
# note: 測試檔案會保留在 /tmp/ii-local-nc-test/ 供檢查。

# stage: zsh | Generate random data and start local nc listener
# lane: kali-listener
# advance: confirm
TEST_DIR=/tmp/ii-local-nc-test
SOURCE_FILE="$TEST_DIR/source.bin"
mkdir -p "$TEST_DIR" &&
head -c 4096 /dev/urandom > "$SOURCE_FILE" &&
printf 'Generated %s bytes in %s\n' "$(wc -c < "$SOURCE_FILE")" "$SOURCE_FILE" &&
nc -q 0 -lvnp $lport < "$SOURCE_FILE"

# stage: zsh | Receive data and verify content
# lane: kali-connector
# advance: confirm
TEST_DIR=/tmp/ii-local-nc-test
SOURCE_FILE="$TEST_DIR/source.bin"
RECEIVED_FILE="$TEST_DIR/received.bin"
rm -f "$RECEIVED_FILE"
if nc 127.0.0.1 $lport > "$RECEIVED_FILE" && cmp -s "$SOURCE_FILE" "$RECEIVED_FILE"; then
  printf '\033[32mSUCCESS\033[0m: nc transfer matched (%s bytes)\n' "$(wc -c < "$RECEIVED_FILE")"
else
  printf '\033[31mFAIL\033[0m: nc transfer failed or files differ\n' >&2
  printf 'source:   %s\nreceived: %s\n' "$SOURCE_FILE" "$RECEIVED_FILE" >&2
  false
fi
