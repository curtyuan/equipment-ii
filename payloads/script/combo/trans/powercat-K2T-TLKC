# description: Kali sends file to Windows TEMP; target listens and Kali connects
# flow: 1
# note: Windows target must already have powercat.

# stage: powershell | Listen and receive file into Windows TEMP
# lane: remote-transfer
# advance: confirm
$PORT = $rport
$RFILE = "${file:t}"
$OUTFILE = Join-Path $env:TEMP $RFILE
Remove-Item $OUTFILE -Force -ErrorAction SilentlyContinue
powercat -l -p $PORT -of $OUTFILE
Write-Output $OUTFILE

# stage: zsh | Connect and send file from Kali
# lane: kali-transfer
# advance: confirm
nc -q 0 $rhost $rport < "$file" || nc -N $rhost $rport < "$file"
