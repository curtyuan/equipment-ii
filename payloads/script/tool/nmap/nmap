mkdir -p "$(pwd)/enum"
OUTFILE="$(pwd)/enum/nmap-tcp-scan.txt"

echo -e "=== lhost=$lhost, rhost=$rhost ===" > "$OUTFILE" && \
sudo nmap -p- -Pn -T4 "$rhost" | tee -a "$OUTFILE" && \
PORTS=$(awk -F/ '/^[0-9]+\/tcp[[:space:]]+open/{print $1}' "$OUTFILE" | paste -sd, -) && \
[[ -n "$PORTS" ]] && \
echo -e "\nPORTS=$PORTS\n" >> "$OUTFILE" && \
echo -e "\n===============================\n" >> "$OUTFILE" && \
sudo nmap -p"$PORTS" -Pn -sC -sV "$rhost" | tee -a "$OUTFILE"
