#!/usr/bin/env zsh
set -e

repo_dir="${0:A:h:h}"
source "${repo_dir}/ii.plugin.zsh"

for topic in ${(f)"$(ii_help_topics)"}; do
  print "===== ii ${topic} ====="
  if [[ "$topic" == "help" ]]; then
    output="$(ii help)"
  else
    output="$(ii help "$topic")"
  fi
  if [[ "$output" != *$'usage:'* || "$output" != *$'Aliases:'* || "$output" != *$'Help:'* ]]; then
    print -u2 "missing usage, Aliases, or Help section: $topic"
    exit 1
  fi
  print -r -- "$output"
  print
done

unset output topic
