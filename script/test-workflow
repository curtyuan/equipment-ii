#!/usr/bin/env zsh

set -eu
setopt pipefail

root="${0:A:h:h}"
II_TMUX_INTEGRATION=0 source "${root}/ii.plugin.zsh"
tmp="$(mktemp -d)"
trap 'rm -rf -- "$tmp"' EXIT

fail() {
  print -u2 -r -- "workflow test failed: $*"
  exit 1
}

fixture="${tmp}/flow"
print -r -- '# description: test workflow
# flow: 1
# note: remote is ready

# stage: zsh | First
# lane: kali-main
# advance: confirm
print "$rhost"

# stage: powershell | Second
# lane: remote-main
# advance: confirm
Write-Output "$rhost"' > "$fixture"

rhost=10.10.10.10
ii_payload_render "$fixture" >/dev/null || fail render
[[ "$II_WORKFLOW_CLASS" == workflow ]] || fail classification
[[ "${#II_WORKFLOW_RENDERED_BODIES}" == 2 ]] || fail stage-count
[[ "${II_WORKFLOW_RENDERED_BODIES[1]}" == 'print "10.10.10.10"'* ]] || fail first-render
[[ "${II_WORKFLOW_RENDERED_BODIES[2]}" == 'Write-Output "10.10.10.10"' ]] || fail second-render
[[ "$II_PAYLOAD_RENDERED_TEXT" == *'lane1: kali-main'* && "$II_PAYLOAD_RENDERED_TEXT" == *'lane2: remote-main'* ]] || fail display
preview="$(ii_payload_preview_text "$fixture")" || fail preview
[[ "$preview" == *'[notes]'* && "$preview" == *'[stage 2/2] lane2: remote-main'* ]] || fail preview-format

typeset -ga copied=()
ii_clip_copy() { copied+=("$1"); }
II_INTERACTIVE_KEY=y ii_workflow_copy_stages >/dev/null || fail staged-copy
[[ "${#copied}" == 2 && "${copied[1]}" != *'Write-Output'* && "${copied[2]}" == 'Write-Output "10.10.10.10"'* ]] || fail staged-copy-bodies

II_WORKFLOW_LANES=(kali-main remote-main)
typeset -gA II_WORKFLOW_LANE_ORDINAL=(kali-main 1 remote-main 2)
ii_workflow_assignment_reset
ii_workflow_assign_lane kali-main %1 detected
ii_workflow_assign_lane remote-main %2 detected
ii_workflow_assign_lane kali-main %2 manual
[[ "${II_WORKFLOW_LANE_PANE[kali-main]}" == %2 && "${II_WORKFLOW_LANE_PANE[remote-main]}" == %1 ]] || fail swap
ii_workflow_toggle_lane kali-main %2
[[ -z "${II_WORKFLOW_LANE_PANE[kali-main]-}" && "${II_WORKFLOW_LANE_PANE[remote-main]}" == %1 ]] || fail toggle
ii_workflow_assign_lane kali-main %2 manual
ii_workflow_assignments_complete || fail complete

invalid="${tmp}/invalid"
print -r -- '# flow: 1
# stage: zsh | Unsafe
# lane: kali-main
# advance: delay 1
print unsafe' > "$invalid"
ii_payload_render "$invalid" >/dev/null 2>&1 && fail invalid-render-fallback
[[ "$II_WORKFLOW_CLASS" == invalid ]] || fail invalid-class

print "workflow render and state tests passed"
