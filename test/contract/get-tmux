#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
invoke="${repo_dir}/test/harness/invoke"
tmp_dir="$(mktemp -d)"
socket="${tmp_dir}/tmux.sock"
trap 'tmux -S "$socket" kill-server 2>/dev/null || true; rm -rf "$tmp_dir"' EXIT

mkdir "${tmp_dir}/bin"
printf '#!/usr/bin/env bash\nhead -n 1\n' >"${tmp_dir}/bin/fzf"
chmod +x "${tmp_dir}/bin/fzf"
export PATH="${tmp_dir}/bin:${PATH}"

tmux -f /dev/null -S "$socket" new-session -d -s get-contract -x 100 -y 30 'zsh -f'
server_pid="$(tmux -S "$socket" display-message -p -t get-contract:0.0 '#{pid}')"
pane="$(tmux -S "$socket" display-message -p -t get-contract:0.0 '#{pane_id}')"
export TMUX="${socket},${server_pid},0"
export TMUX_PANE="$pane"
export II_TMUX_INTEGRATION=0 II_CLIP_BACKEND=tmux
tmux -S "$socket" set-environment ii_rhost 192.0.2.20
tmux -S "$socket" set-environment ii_lhost 192.0.2.10

while IFS=$'\t' read -r name arguments expected_status expected_value; do
  [[ -n "$name" && "$name" != \#* ]] || continue
  read -r -a command_args <<<"$arguments"
  tmux -S "$socket" delete-buffer 2>/dev/null || true
  set +e
  "$invoke" "${command_args[@]}" >"${tmp_dir}/${name}.out" 2>"${tmp_dir}/${name}.err"
  status=$?
  set -e
  [[ "$status" == "$expected_status" ]]
  if [[ "$expected_status" == 0 ]]; then
    printf 'value copied successfully\n\n%s\n' "$expected_value" >"${tmp_dir}/${name}.expected.out"
    diff -u "${tmp_dir}/${name}.expected.out" "${tmp_dir}/${name}.out"
    [[ ! -s "${tmp_dir}/${name}.err" ]]
    [[ "$(tmux -S "$socket" save-buffer -)" == "$expected_value" ]]
  else
    [[ ! -s "${tmp_dir}/${name}.out" ]]
    grep -Fx 'no matched' "${tmp_dir}/${name}.err"
  fi
done <"${repo_dir}/test/fixtures/get-command.tsv"

printf 'get command tmux fixture contracts passed\n'
