#!/usr/bin/env zsh
set -eu

root="${0:A:h:h:h}"
tmp_dir="$(mktemp -d)"
socket="${tmp_dir}/tmux.sock"
trap 'tmux -S "$socket" kill-server 2>/dev/null || true; command rm -rf -- "$tmp_dir"' EXIT

tmux -f /dev/null -S "$socket" new-session -d -s ordinary-set -x 80 -y 24 'zsh -f'
server_pid="$(tmux -S "$socket" display-message -p -t ordinary-set:0.0 '#{pid}')"
pane="$(tmux -S "$socket" display-message -p -t ordinary-set:0.0 '#{pane_id}')"
export TMUX="${socket},${server_pid},0"
export TMUX_PANE="$pane"

mkdir "${tmp_dir}/bin"
cat >"${tmp_dir}/bin/ii-go" <<'EOF'
#!/usr/bin/env sh
printf '%s\n' "$*" >>"$II_GO_CALL_LOG"
printf 'ordinary command unexpectedly invoked Go: %s\n' "$*" >&2
exit 99
EOF
chmod +x "${tmp_dir}/bin/ii-go"
cat >"${tmp_dir}/bin/fzf" <<'EOF'
#!/usr/bin/env sh
filter="${FZF_DEFAULT_OPTS#*--filter=}"
filter="${filter%% *}"
awk -v filter="$filter" 'BEGIN {IGNORECASE=1} filter == "" || index(tolower($0), tolower(filter)) {print; exit}'
EOF
chmod +x "${tmp_dir}/bin/fzf"
export PATH="${tmp_dir}/bin:${PATH}"
export II_GO_CALL_LOG="${tmp_dir}/go.calls"
export II_GO_BIN="${tmp_dir}/bin/ii-go"
export II_CONFIG_FILE=/dev/null
export II_TMUX_INTEGRATION=0

source "${root}/src/zsh/ii.plugin.zsh"
: >"$II_GO_CALL_LOG"

ii s note 'two words' >"${tmp_dir}/set.out"
[[ "$note" == 'two words' ]]
[[ "$(tmux -S "$socket" show-environment ii_note)" == 'ii_note=two words' ]]
grep -Fx 'note=two words' "${tmp_dir}/set.out"

ii s note= >"${tmp_dir}/empty-assignment.out"
grep -Fx 'unset note' "${tmp_dir}/empty-assignment.out"
(( ! ${+parameters[note]} ))
if tmux -S "$socket" show-environment ii_note >/dev/null 2>&1; then
  print -u2 'empty assignment left ii_note in tmux'
  exit 1
fi

typeset empty_shell=''
tmux -S "$socket" set-environment ii_empty_shell stale
ii s empty_shell --from-shell >"${tmp_dir}/empty-shell.out"
grep -Fx 'unset empty_shell' "${tmp_dir}/empty-shell.out"
if tmux -S "$socket" show-environment ii_empty_shell >/dev/null 2>&1; then
  print -u2 'empty --from-shell value left ii_empty_shell in tmux'
  exit 1
fi

ii s note 'two words' >"${tmp_dir}/restore-note.out"

ii s:domain=example.test,lport=4444 >"${tmp_dir}/compact.out"
[[ "$domain" == example.test && "$lport" == 4444 ]]
[[ "$(tmux -S "$socket" show-environment ii_domain)" == 'ii_domain=example.test' ]]
[[ "$(tmux -S "$socket" show-environment ii_lport)" == 'ii_lport=4444' ]]

II_AUTO_DETECT_LHOST=0 ii sr 198.51.100.7 >"${tmp_dir}/sr.out"
[[ "$rhost" == 198.51.100.7 ]]
[[ "$(tmux -S "$socket" show-environment ii_rhost)" == 'ii_rhost=198.51.100.7' ]]

typeset shell_only=from-shell
ii s shell_only --from-shell >"${tmp_dir}/from-shell.out"
[[ "$(tmux -S "$socket" show-environment ii_shell_only)" == 'ii_shell_only=from-shell' ]]

typeset shell_alias=from-sh
ii sh shell_alias >"${tmp_dir}/sh.out"
[[ "$(tmux -S "$socket" show-environment ii_shell_alias)" == 'ii_shell_alias=from-sh' ]]

typeset domain=all-domain lport=8443
ii s --from-shell --all >"${tmp_dir}/from-shell-all.out"
[[ "$(tmux -S "$socket" show-environment ii_domain)" == 'ii_domain=all-domain' ]]
[[ "$(tmux -S "$socket" show-environment ii_lport)" == 'ii_lport=8443' ]]

typeset domain=sha-domain
ii sha >"${tmp_dir}/sha.out"
[[ "$(tmux -S "$socket" show-environment ii_domain)" == 'ii_domain=sha-domain' ]]

print -r -- "file_only='two words'" >"${tmp_dir}/vars.env"
print -r -- "empty_file=''" >>"${tmp_dir}/vars.env"
tmux -S "$socket" set-environment ii_empty_file stale
typeset empty_file=stale
ii sf "${tmp_dir}/vars.env" >"${tmp_dir}/from-file.out"
[[ "$file_only" == 'two words' ]]
[[ "$(tmux -S "$socket" show-environment ii_file_only)" == 'ii_file_only=two words' ]]
(( ! ${+parameters[empty_file]} ))
if tmux -S "$socket" show-environment ii_empty_file >/dev/null 2>&1; then
  print -u2 'empty --from-file value left ii_empty_file in tmux'
  exit 1
fi

unset note
ii l >"${tmp_dir}/load.out"
[[ "$note" == 'two words' ]]

ii u file_only >"${tmp_dir}/unset.out"
(( ! ${+parameters[file_only]} ))
if tmux -S "$socket" show-environment ii_file_only >/dev/null 2>&1; then
  print -u2 'ordinary unset left ii_file_only in tmux'
  exit 1
fi

ii ls note >"${tmp_dir}/list.out"
grep -Fx note "${tmp_dir}/list.out"
grep -Fx 'two words' "${tmp_dir}/list.out"

ii vo "${tmp_dir}/output.env" >"${tmp_dir}/output.out"
grep -Fx "note='two words'" "${tmp_dir}/output.env"

II_CLIP_BACKEND=tmux ii gr >"${tmp_dir}/get.out"
grep -Fx '198.51.100.7' "${tmp_dir}/get.out"
[[ "$(tmux -S "$socket" save-buffer -)" == 198.51.100.7 ]]

ii clip backend tmux >"${tmp_dir}/clip.out"
[[ "$II_CLIP_BACKEND" == tmux ]]
[[ "$(tmux -S "$socket" show-environment II_CLIP_BACKEND)" == II_CLIP_BACKEND=tmux ]]

FZF_DEFAULT_OPTS='--filter=add' II_ADD_VAR_FILTER=interactive II_ADD_VALUE_FILTER=created \
  ii i >"${tmp_dir}/interactive-add.out"
[[ "$interactive" == created ]]
[[ "$(tmux -S "$socket" show-environment ii_interactive)" == ii_interactive=created ]]

FZF_DEFAULT_OPTS='--filter=interactive' II_INTERACTIVE_KEY=i II_EDIT_VALUE_FILTER=edited \
  ii i >"${tmp_dir}/interactive-edit.out"
[[ "$interactive" == edited ]]
[[ "$(tmux -S "$socket" show-environment ii_interactive)" == ii_interactive=edited ]]

FZF_DEFAULT_OPTS='--filter=interactive' II_INTERACTIVE_KEY=y II_CLIP_BACKEND=tmux \
  ii i >"${tmp_dir}/interactive-copy.out"
[[ "$(tmux -S "$socket" save-buffer -)" == edited ]]

[[ ! -s "$II_GO_CALL_LOG" ]]
print 'ordinary Zsh set contract passed'
