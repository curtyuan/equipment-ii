#!/usr/bin/env zsh
set -eu

root="${0:A:h:h:h}"
tmp_dir="$(mktemp -d)"
socket="${tmp_dir}/tmux.sock"
trap 'tmux -S "$socket" kill-server 2>/dev/null || true; command rm -rf -- "$tmp_dir"' EXIT

mkdir -p "${tmp_dir}/bin" "${tmp_dir}/payloads/shell/linux" "${tmp_dir}/work"
cat >"${tmp_dir}/bin/fzf" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
filter="${FZF_DEFAULT_OPTS#*--filter=}"
filter="${filter%% *}"
awk -F '\t' -v filter="$filter" 'index(tolower($1), tolower(filter)) {print; exit}'
EOF
chmod +x "${tmp_dir}/bin/fzf"
export PATH="${tmp_dir}/bin:${PATH}"

cat >"${tmp_dir}/payloads/shell/linux/render" <<'EOF'
echo "$rhost" "$lhost"
EOF
cat >"${tmp_dir}/payloads/shell/linux/execute" <<EOF
typeset -g payload_protocol_executed=yes
builtin cd -- ${(q)tmp_dir}/work
EOF
cat >"${tmp_dir}/payloads/shell/linux/workflow" <<'EOF'
# flow: 1
# stage: zsh | first
# lane: kali-main
# advance: confirm
print first
# stage: zsh | second
# lane: kali-main
# advance: confirm
print second
EOF

tmux -f /dev/null -S "$socket" new-session -d -s payload-select-contract 'zsh -f'
server_pid="$(tmux -S "$socket" display-message -p -t payload-select-contract:0.0 '#{pid}')"
pane="$(tmux -S "$socket" display-message -p -t payload-select-contract:0.0 '#{pane_id}')"
export TMUX="${socket},${server_pid},0"
export TMUX_PANE="$pane"
export II_PAYLOAD_DIR="${tmp_dir}/payloads"
export II_CLIP_BACKEND=tmux
tmux -S "$socket" set-environment ii_lhost tmux-lhost

state_file="${tmp_dir}/state"
printf '%s\0' ii-shell-state-v1 rhost 1 shell-rhost lhost 0 '' >"$state_file"

FZF_DEFAULT_OPTS='--filter=render' II_PAYLOAD_KEY=enter II_SHELL_STATE_FILE="$state_file" \
  "${root}/build/ii-go" __payload_select linux >"${tmp_dir}/render.out"
grep -Fx 'echo "shell-rhost" "tmux-lhost"' "${tmp_dir}/render.out"

FZF_DEFAULT_OPTS='--filter=render' II_PAYLOAD_KEY=y II_SHELL_STATE_FILE="$state_file" \
  "${root}/build/ii-go" __payload_select linux >"${tmp_dir}/copy.out"
grep -Fx 'payload copied successfully' "${tmp_dir}/copy.out"
[[ "$(tmux -S "$socket" save-buffer -)" == 'echo "shell-rhost" "tmux-lhost"' ]]

FZF_DEFAULT_OPTS='--filter=workflow' II_PAYLOAD_KEY=y II_INTERACTIVE_KEY=y \
  II_SHELL_STATE_FILE="$state_file" "${root}/build/ii-go" __payload_select linux \
  >"${tmp_dir}/workflow.out"
grep -Fx 'stage 1/2 copied successfully' "${tmp_dir}/workflow.out"
grep -Fx 'stage 2/2 copied successfully' "${tmp_dir}/workflow.out"
[[ "$(tmux -S "$socket" save-buffer -)" == 'print second' ]]

ops_file="${tmp_dir}/ops"
exec_file="${tmp_dir}/exec"
: >"$ops_file"
: >"$exec_file"
FZF_DEFAULT_OPTS='--filter=execute' II_PAYLOAD_KEY=enter II_INTERACTIVE_KEY=y \
  II_SHELL_STATE_FILE="$state_file" II_SHELL_OPS_FILE="$ops_file" II_SHELL_EXEC_FILE="$exec_file" \
  "${root}/build/ii-go" __payload_select --execute linux >"${tmp_dir}/execute.out"
grep -Fx 'executing payload in current shell:' "${tmp_dir}/execute.out"

II_CONFIG_FILE=/dev/null source "${root}/ii.plugin.zsh"
ii_apply_shell_operations "$ops_file" "$exec_file"
[[ "$payload_protocol_executed" == yes ]]
[[ "$PWD" == "${tmp_dir}/work" ]]

print "payload selector, copy, workflow-copy, and execute-file contracts passed"
