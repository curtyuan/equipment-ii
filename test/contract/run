#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
invoke="${repo_dir}/test/harness/invoke"
tmp_dir="$(mktemp -d)"
trap 'rm -r "$tmp_dir"' EXIT

check_help() {
  local name="$1" topic="$2"
  shift 2
  TMUX= TMUX_PANE= II_CONTRACT_COLOR=never II_CONTRACT_NO_COLOR=1 \
    "$invoke" go "$@" >"${tmp_dir}/${name}.out" 2>"${tmp_dir}/${name}.err"
  diff -u "${repo_dir}/help/${topic}.txt" "${tmp_dir}/${name}.out"
  [[ ! -s "${tmp_dir}/${name}.err" ]]
}

check_help empty top
check_help help top help
check_help h top h
check_help short-help top -h
check_help long-help top --help
check_help list list help list
check_help list-alias list ls --help
check_help set set help set
check_help set-alias set help sf
check_help load load load --help
check_help unset unset help unset
check_help get get get --help
check_help payload payload help payload
check_help payload-copy payload-copy help pc
check_help payload-execute payload-execute help pe
check_help payload-copy-execute payload-copy-execute help pce
check_help payload-input payload-input help payload --input
check_help tmux tmux help tmux
check_help version-help version version --help

TMUX= TMUX_PANE= "$invoke" go version >"${tmp_dir}/version.out" 2>"${tmp_dir}/version.err"
grep -Fx "ii $(<"${repo_dir}/VERSION")" "${tmp_dir}/version.out"
[[ ! -s "${tmp_dir}/version.err" ]]

set +e
TMUX= TMUX_PANE= "$invoke" go no-such-command >"${tmp_dir}/unknown.out" 2>"${tmp_dir}/unknown.err"
unknown_status=$?
TMUX= TMUX_PANE= "$invoke" go sync >"${tmp_dir}/sync.out" 2>"${tmp_dir}/sync.err"
sync_status=$?
set -e
[[ "$unknown_status" == 2 && "$sync_status" == 2 ]]
grep -Fx 'ii: unknown command: no-such-command' "${tmp_dir}/unknown.err"
grep -Fx 'ii: unknown command: sync' "${tmp_dir}/sync.err"
diff -u "${repo_dir}/help/top.txt" "${tmp_dir}/unknown.out"

TMUX= TMUX_PANE= II_CONTRACT_COLOR=always II_CONTRACT_NO_COLOR= \
  "$invoke" go help >"${tmp_dir}/color.out" 2>"${tmp_dir}/color.err"
grep -Fq $'\033[36m' "${tmp_dir}/color.out"
[[ ! -s "${tmp_dir}/color.err" ]]

printf 'public command contracts passed (repository help fixtures)\n'
