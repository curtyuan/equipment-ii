#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
invoke="${repo_dir}/test/harness/invoke"
tmp_dir="$(mktemp -d)"
socket="${tmp_dir}/tmux.sock"
trap 'tmux -S "$socket" kill-server 2>/dev/null || true; rm -rf "$tmp_dir"' EXIT

tmux -f /dev/null -S "$socket" new-session -d -s set-contract -x 100 -y 30 'zsh -f'
server_pid="$(tmux -S "$socket" display-message -p -t set-contract:0.0 '#{pid}')"
pane="$(tmux -S "$socket" display-message -p -t set-contract:0.0 '#{pane_id}')"
export TMUX="${socket},${server_pid},0"
export TMUX_PANE="$pane"
export II_AUTO_DETECT_LHOST=0
# Alias installation has its own contract; keep repeated backends isolated.
export II_TMUX_INTEGRATION=0

printf "domain='example.test'\n" >"${tmp_dir}/vars.env"
while IFS='|' read -r name variable encoded_args expected_status expected_out expected_err expected_state; do
  [[ -n "$name" && "$name" != \#* ]] || continue
  encoded_args="${encoded_args//@VARS@/${tmp_dir}\/vars.env}"
  IFS=',' read -r -a command_args <<<"$encoded_args"
  tmux -S "$socket" set-environment -u "$variable" 2>/dev/null || true
  set +e
  "$invoke" "${command_args[@]}" >"${tmp_dir}/${name}.out" 2>"${tmp_dir}/${name}.err"
  actual_status=$?
  set -e
  tmux -S "$socket" show-environment "$variable" >"${tmp_dir}/${name}.state" 2>/dev/null || true
  printf '%b' "$expected_out" >"${tmp_dir}/${name}.expected.out"
  printf '%b' "$expected_err" >"${tmp_dir}/${name}.expected.err"
  printf '%b' "$expected_state" >"${tmp_dir}/${name}.expected.state"
  [[ "$actual_status" == "$expected_status" ]]
  diff -u "${tmp_dir}/${name}.expected.out" "${tmp_dir}/${name}.out"
  diff -u "${tmp_dir}/${name}.expected.err" "${tmp_dir}/${name}.err"
  diff -u "${tmp_dir}/${name}.expected.state" "${tmp_dir}/${name}.state"
done <"${repo_dir}/test/fixtures/set-command.tsv"

printf 'set command tmux fixture contracts passed\n'
