#!/usr/bin/env zsh
set -eu

root="${0:A:h:h:h}"
tmp_dir="$(mktemp -d)"
ops="${tmp_dir}/ops"
bad="${tmp_dir}/bad"
exec_file="${tmp_dir}/execute"
trap 'command rm -rf -- "$tmp_dir"' EXIT

II_CONFIG_FILE=/dev/null source "${root}/ii.plugin.zsh"

{
  print -rn -- 'ii-shell-ops-v1'$'\0'
  print -rn -- 'export'$'\0''ii_protocol_value'$'\0''two words
and quotes '\'' "$ () ;'$'\0'
  print -rn -- 'unset'$'\0''ii_protocol_remove'$'\0\0'
  print -rn -- 'execute-file'$'\0\0'"$exec_file"$'\0'
} > "$ops"
print -r -- 'typeset -g ii_protocol_executed=yes' >"$exec_file"

typeset -g ii_protocol_remove=present
ii_apply_shell_operations "$ops" "$exec_file"
[[ "$ii_protocol_value" == $'two words\nand quotes '\'' "$ () ;' ]]
(( ! ${+parameters[ii_protocol_remove]} ))
[[ "$ii_protocol_executed" == yes ]]

{
  print -rn -- 'ii-shell-ops-v1'$'\0'
  print -rn -- 'export'$'\0''bad; print injected'$'\0''value'$'\0'
} > "$bad"
if ii_apply_shell_operations "$bad" 2>/dev/null; then
  print -u2 "shell operation contract accepted an injection name"
  exit 1
fi

{
  print -rn -- 'ii-shell-ops-v1'$'\0'
  print -rn -- 'execute-file'$'\0\0''/tmp/not-authorized'$'\0'
} > "$bad"
if ii_apply_shell_operations "$bad" "$exec_file" 2>/dev/null; then
  print -u2 "shell operation contract accepted an unauthorized execution path"
  exit 1
fi

print "parent-shell operation protocol contract passed"
