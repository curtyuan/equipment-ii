#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
tmp_dir="$(mktemp -d)"
socket="${tmp_dir}/tmux.sock"
trap 'tmux -S "$socket" kill-server 2>/dev/null || true; command rm -rf -- "$tmp_dir"' EXIT

tmux -f /dev/null -S "$socket" new-session -d -s tmux-install-contract 'zsh -f'
server_pid="$(tmux -S "$socket" display-message -p -t tmux-install-contract:0.0 '#{pid}')"
pane="$(tmux -S "$socket" display-message -p -t tmux-install-contract:0.0 '#{pane_id}')"
export TMUX="${socket},${server_pid},0"
export TMUX_PANE="$pane"
export II_GO_BIN="${II_GO_BIN:-${repo_dir}/build/ii-go}"

ensure() {
  II_CONFIG_FILE=/dev/null II_GO_ROOT="$repo_dir" II_GO_BIN="$II_GO_BIN" \
    zsh -f -c 'source "$1"; ii_zsh_tmux_ensure' zsh "${repo_dir}/src/zsh/ii.plugin.zsh" \
    >"${tmp_dir}/ensure.out" 2>"${tmp_dir}/ensure.err"
}

ensure
alias_value="$(tmux -S "$socket" show-option -sv 'command-alias[100]')"
[[ "$alias_value" == ii=display-popup*"${repo_dir}/src/zsh/script/ii-tmux-popup"*"execute"*"#{pane_id}"*"#{session_id}"* ]]
marker="$(tmux -S "$socket" show-option -gqv @ii_integration_marker)"
[[ "$marker" == "version=3 index=100 helper=${repo_dir}/src/zsh/script/ii-tmux-popup" ]]
[[ ! -s "${tmp_dir}/ensure.err" ]]

ensure
[[ "$(tmux -S "$socket" show-option -sv 'command-alias[100]')" == "$alias_value" ]]
[[ ! -s "${tmp_dir}/ensure.err" ]]

tmux -S "$socket" set-option -s 'command-alias[100]' 'ii=display-message user-owned'
tmux -S "$socket" set-option -gu @ii_integration_marker
ensure
grep -Fx "ii: tmux command alias 'ii' is already defined; ii popup alias was not installed" \
  "${tmp_dir}/ensure.err"
[[ "$(tmux -S "$socket" show-option -sv 'command-alias[100]')" == 'ii=display-message user-owned' ]]

ensure
[[ ! -s "${tmp_dir}/ensure.err" ]]

II_TMUX_INTEGRATION_FORCE=1 ensure
[[ "$(tmux -S "$socket" show-option -sv 'command-alias[100]')" == ii=display-popup*"${repo_dir}/src/zsh/script/ii-tmux-popup"* ]]

tmux -S "$socket" set-option -s 'command-alias[100]' 'ii=display-message disabled-check'
II_TMUX_INTEGRATION=0 ensure
[[ "$(tmux -S "$socket" show-option -sv 'command-alias[100]')" == 'ii=display-message disabled-check' ]]

tmux -S "$socket" set-option -su 'command-alias[100]'
tmux -S "$socket" set-option -gu @ii_integration_marker
tmux -S "$socket" set-option -gu @ii_integration_conflict_notice
ensure
[[ "$(tmux -S "$socket" show-option -sv 'command-alias[100]')" == ii=display-popup*"${repo_dir}/src/zsh/script/ii-tmux-popup"* ]]
[[ "$(tmux -S "$socket" show-option -gqv @ii_integration_marker)" == \
  "version=3 index=100 helper=${repo_dir}/src/zsh/script/ii-tmux-popup" ]]

printf 'tmux alias installation contracts passed\n'
