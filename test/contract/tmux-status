#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
invoke="${repo_dir}/test/harness/invoke"
tmp_dir="$(mktemp -d)"
socket="${tmp_dir}/tmux.sock"
trap 'tmux -S "$socket" kill-server 2>/dev/null || true; rm -rf "$tmp_dir"' EXIT

tmux -f /dev/null -S "$socket" new-session -d -s tmux-status-contract 'zsh -f'
server_pid="$(tmux -S "$socket" display-message -p -t tmux-status-contract:0.0 '#{pid}')"
pane="$(tmux -S "$socket" display-message -p -t tmux-status-contract:0.0 '#{pane_id}')"
export TMUX="${socket},${server_pid},0"
export TMUX_PANE="$pane"

"$invoke" tmux status >"${tmp_dir}/status.out" 2>"${tmp_dir}/status.err"
[[ ! -s "${tmp_dir}/status.err" ]]
grep -Fx "server: $socket" "${tmp_dir}/status.out"
grep -Fx "helper: ${repo_dir}/script/ii-tmux-popup" "${tmp_dir}/status.out"
sed -e '/^server:/d' -e '/^helper:/d' "${tmp_dir}/status.out" >"${tmp_dir}/status.stable"
diff -u "${repo_dir}/test/fixtures/tmux-status.txt" "${tmp_dir}/status.stable"

set +e
"$invoke" tmux invalid >"${tmp_dir}/invalid.out" 2>"${tmp_dir}/invalid.err"
status=$?
set -e
[[ "$status" == 2 && ! -s "${tmp_dir}/invalid.out" ]]
grep -Fx 'ii: usage: ii tmux status' "${tmp_dir}/invalid.err"

printf 'tmux status fixture contracts passed\n'
