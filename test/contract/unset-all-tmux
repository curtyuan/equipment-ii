#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
invoke="${repo_dir}/test/harness/invoke"
tmp_dir="$(mktemp -d)"
socket="${tmp_dir}/tmux.sock"
trap 'tmux -S "$socket" kill-server 2>/dev/null || true; rm -rf "$tmp_dir"' EXIT

tmux -f /dev/null -S "$socket" new-session -d -s unset-contract -x 100 -y 30 'zsh -f'
server_pid="$(tmux -S "$socket" display-message -p -t unset-contract:0.0 '#{pid}')"
pane="$(tmux -S "$socket" display-message -p -t unset-contract:0.0 '#{pane_id}')"
export TMUX="${socket},${server_pid},0"
export TMUX_PANE="$pane"
export II_TMUX_INTEGRATION=0

while IFS=$'\t' read -r name answer expected_status expected_remaining; do
  [[ -n "$name" && "$name" != \#* ]] || continue
  tmux -S "$socket" set-environment ii_alpha one
  tmux -S "$socket" set-environment ii_beta two
  set +e
  printf '%s\n' "$answer" | "$invoke" u -a >"${tmp_dir}/${name}.out" 2>"${tmp_dir}/${name}.err"
  status=$?
  set -e
  [[ "$status" == "$expected_status" ]]
  [[ ! -s "${tmp_dir}/${name}.err" ]]
  state="$(tmux -S "$socket" show-environment | grep '^ii_' | LC_ALL=C sort || true)"
  if [[ "$expected_remaining" == 2 ]]; then
    [[ "$state" == $'ii_alpha=one\nii_beta=two' ]]
    [[ "$(<"${tmp_dir}/${name}.out")" == 'unset all ii_ variables in this tmux session? [y/N] aborted' ]]
  else
    [[ -z "$state" ]]
    grep -Fx 'unset 2 variable(s)' "${tmp_dir}/${name}.out"
  fi
done <"${repo_dir}/test/fixtures/unset-all.tsv"

printf 'unset-all tmux fixture contracts passed\n'
