#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
invoke="${repo_dir}/test/harness/invoke"
tmp_dir="$(mktemp -d)"
socket="${tmp_dir}/tmux.sock"
trap 'tmux -S "$socket" kill-server 2>/dev/null || true; rm -rf "$tmp_dir"' EXIT

tmux -f /dev/null -S "$socket" new-session -d -s output-contract -x 100 -y 30 'zsh -f'
server_pid="$(tmux -S "$socket" display-message -p -t output-contract:0.0 '#{pid}')"
pane="$(tmux -S "$socket" display-message -p -t output-contract:0.0 '#{pane_id}')"
export TMUX="${socket},${server_pid},0"
export TMUX_PANE="$pane"
export II_TMUX_INTEGRATION=0

tmux set-environment -t output-contract ii_plain value
tmux set-environment -t output-contract ii_space "two words"
tmux set-environment -t output-contract ii_quote "a'b"
tmux set-environment -t output-contract ii_symbols 'dollar$ back\slash;bang!'
tmux set-environment -t output-contract ii_equals "a=b"
tmux set-environment -t output-contract ii_empty ""
tmux set-environment -t output-contract unrelated ignored

check_output() {
  local name="$1"
  shift
  local target="${tmp_dir}/${name}.env"
  "$invoke" "$@" "$target" >"${tmp_dir}/${name}.out" 2>"${tmp_dir}/${name}.err"
  printf 'wrote 5 variable(s) to %s\n' "$target" >"${tmp_dir}/${name}.expected.out"
  diff -u "${tmp_dir}/${name}.expected.out" "${tmp_dir}/${name}.out"
  [[ ! -s "${tmp_dir}/${name}.err" ]]
  diff -u "${repo_dir}/test/fixtures/variable-output.txt" "$target"
}

check_output v-output v --out
check_output vo vo
check_output voc voc

cover_target="${tmp_dir}/cover.env"
printf "APP_TOKEN='preserve me'\nplain='old'\ndomain='remove me'\n" >"$cover_target"
printf 'c\n' | "$invoke" vo "$cover_target" >"${tmp_dir}/cover.out" 2>"${tmp_dir}/cover.err"
grep -Fx -- "- domain='remove me'" "${tmp_dir}/cover.out"
grep -Fx -- "- plain='old'" "${tmp_dir}/cover.out"
grep -Fx -- "+ plain='value'" "${tmp_dir}/cover.out"
! grep -F 'APP_TOKEN' "${tmp_dir}/cover.out"
grep -F "(Y) update current variables / (C) cover all / (N) abort:" "${tmp_dir}/cover.out"
grep -F "wrote 6 variable(s) to $cover_target" "${tmp_dir}/cover.out"
[[ ! -s "${tmp_dir}/cover.err" ]]
grep -Fx "APP_TOKEN='preserve me'" "$cover_target"
! grep -q '^domain=' "$cover_target"
diff -u <(sort "${repo_dir}/test/fixtures/variable-output.txt") <(grep -v '^APP_TOKEN=' "$cover_target" | sort)

keep_target="${tmp_dir}/keep.env"
printf "# retained note\nplain='old'\nlegacy='keep me'\n" >"$keep_target"
printf 'y\n' | "$invoke" vo "$keep_target" >"${tmp_dir}/keep.out" 2>"${tmp_dir}/keep.err"
grep -F "wrote 6 variable(s) to $keep_target" "${tmp_dir}/keep.out"
[[ ! -s "${tmp_dir}/keep.err" ]]
grep -Fx "plain='value'" "$keep_target"
grep -Fx "legacy='keep me'" "$keep_target"
grep -Fx '# retained note' "$keep_target"
[[ "$(grep -c '^plain=' "$keep_target")" == 1 ]]

abort_target="${tmp_dir}/abort.env"
printf "plain='old'\nlegacy='unchanged'\n" >"$abort_target"
cp "$abort_target" "${tmp_dir}/abort.expected"
set +e
printf 'n\n' | "$invoke" vo "$abort_target" >"${tmp_dir}/abort.out" 2>"${tmp_dir}/abort.err"
abort_status=$?
set -e
[[ "$abort_status" == 1 && ! -s "${tmp_dir}/abort.err" ]]
grep -F '(Y) update current variables / (C) cover all / (N) abort: aborted' "${tmp_dir}/abort.out"
diff -u "${tmp_dir}/abort.expected" "$abort_target"

subset_target="${tmp_dir}/subset.env"
printf "plain='old'\n" >"$subset_target"
printf 'y\n' | "$invoke" vo "$subset_target" >"${tmp_dir}/subset.out" 2>"${tmp_dir}/subset.err"
[[ ! -s "${tmp_dir}/subset.err" ]]
grep -F 'cover all' "${tmp_dir}/subset.out"
diff -u <(sort "${repo_dir}/test/fixtures/variable-output.txt") <(sort "$subset_target")

color_target="${tmp_dir}/color.env"
printf "domain='red'\nplain='old'\n" >"$color_target"
printf 'n\n' | II_CONTRACT_COLOR=always II_CONTRACT_NO_COLOR= "$invoke" vo "$color_target" >"${tmp_dir}/color.out" 2>"${tmp_dir}/color.err" || true
grep -F $'\e[31m- domain=' "${tmp_dir}/color.out"
grep -F $'\e[31m- plain=' "${tmp_dir}/color.out"
grep -F $'\e[34m+ plain=' "${tmp_dir}/color.out"
grep -F $'\e[34m+ quote=' "${tmp_dir}/color.out"
[[ ! -s "${tmp_dir}/color.err" ]]

matching_target="${tmp_dir}/matching.env"
cp "${repo_dir}/test/fixtures/variable-output.txt" "$matching_target"
"$invoke" vo "$matching_target" >"${tmp_dir}/matching.out" 2>"${tmp_dir}/matching.err"
grep -Fx "$matching_target already matches the current variables" "${tmp_dir}/matching.out"
[[ ! -s "${tmp_dir}/matching.err" ]]

(
  cd "$tmp_dir"
  "$invoke" vo >default.out 2>default.err
  printf 'wrote 5 variable(s) to %s/.env\n' "$tmp_dir" >default.expected.out
  diff -u default.expected.out default.out
  [[ ! -s default.err ]]
  diff -u "${repo_dir}/test/fixtures/variable-output.txt" .env
)

directory="${tmp_dir}/directory"
mkdir "$directory"
set +e
"$invoke" vo "$directory" >"${tmp_dir}/directory.out" 2>"${tmp_dir}/directory.err"
directory_status=$?
"$invoke" vo "${tmp_dir}/missing/out.env" >"${tmp_dir}/missing.out" 2>"${tmp_dir}/missing.err"
missing_status=$?
"$invoke" vo one two >"${tmp_dir}/usage.out" 2>"${tmp_dir}/usage.err"
usage_status=$?
set -e
[[ "$directory_status" == 1 && "$missing_status" == 1 && "$usage_status" == 2 ]]
[[ ! -s "${tmp_dir}/directory.out" && ! -s "${tmp_dir}/missing.out" && ! -s "${tmp_dir}/usage.out" ]]
grep -Fx "ii: output path is a directory: $directory" "${tmp_dir}/directory.err"
grep -Fx "ii: output directory not found: ${tmp_dir}/missing" "${tmp_dir}/missing.err"
grep -Fx 'ii: usage: ii v --out [PATH] | ii vo [PATH]' "${tmp_dir}/usage.err"

printf 'variable output tmux fixture contracts passed\n'
