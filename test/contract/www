#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
invoke="${repo_dir}/test/harness/invoke"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

source_file="${tmp_dir}/source.txt"
printf 'echo hello\n' >"$source_file"

run_case() {
  local backend="$1" name="$2"
  shift 2
  local root="${tmp_dir}/${backend}/www"
  rm -rf "${tmp_dir:?}/${backend}"
  mkdir -p "$root/uploads"
  printf 'nested\n' >"$root/uploads/nested.txt"
  II_WWW_ROOT="$root" II_PAYLOAD_DIR="${repo_dir}/ori-ii/payloads" II_TMUX_INTEGRATION=0 \
    FZF_DEFAULT_OPTS='--filter=uploads' \
    "$invoke" "$backend" "$@" >"${tmp_dir}/${name}.${backend}.out" \
    2>"${tmp_dir}/${name}.${backend}.err"
  sed "s|${tmp_dir}/${backend}/www|WEB_ROOT|g" "${tmp_dir}/${name}.${backend}.out" \
    >"${tmp_dir}/${name}.${backend}.normalized"
}

compare_case() {
  local name="$1"
  shift
  run_case legacy "$name" "$@"
  run_case go "$name" "$@"
  diff -u "${tmp_dir}/${name}.legacy.normalized" "${tmp_dir}/${name}.go.normalized"
  diff -u "${tmp_dir}/${name}.legacy.err" "${tmp_dir}/${name}.go.err"
}

compare_case list p --www ls
compare_case search p --www search nested.txt
compare_case link p --www ln "$source_file" source-link
compare_case publish p --www --file "$source_file"

printf 'www semantic differential contracts passed\n'
