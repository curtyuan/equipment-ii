#!/usr/bin/env bash
set -euo pipefail

if (($# < 1)); then
  printf 'usage: invoke legacy|go [ARGS...]\n' >&2
  exit 2
fi

backend="$1"
shift
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

case "$backend" in
  legacy)
    plugin="${repo_dir}/ori-ii/ii.plugin.zsh"
    ;;
  go)
    plugin="${repo_dir}/ii.plugin.zsh"
    ;;
  *)
    printf 'unknown contract backend: %s\n' "$backend" >&2
    exit 2
    ;;
esac

II_CONFIG_FILE=/dev/null \
II_COLOR="${II_CONTRACT_COLOR:-never}" \
NO_COLOR="${II_CONTRACT_NO_COLOR-1}" \
II_GO_BIN="${II_GO_BIN:-${repo_dir}/build/ii-go}" \
zsh -f -c 'source "$1"; shift; ii "$@"' zsh "$plugin" "$@"
